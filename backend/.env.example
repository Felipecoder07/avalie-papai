# ==============================================================================
# ARENIX / COURTMANAGER — CONFIGURAÇÕES DE AMBIENTE (BACKEND)
# ==============================================================================

# Porta do servidor HTTP (padrão: 3000)
PORT=3000

# Ambiente de execução:
# - 'production': desativa simuladores de pagamentos para todos os usuários e aplica CORS estrito
# - 'development': habilita CORS permissivo e simuladores para testes locais
NODE_ENV=production

# Chave secreta de assinatura JWT para autenticação de administradores, gestores e atletas
# IMPORTANTE: Gere uma chave longa e aleatória (mínimo 64 caracteres)
# Exemplo de geração via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=seu_jwt_secret_super_seguro_de_producao_aqui

# Origens permitidas pela política de CORS (separadas por vírgula, sem barra no final)
# Defina o domínio público do painel gestor e da tela pública de reservas
CORS_ALLOWED_ORIGINS=https://app.arenix.com.br,https://reservas.arenix.com.br

# URL pública do painel frontend (usada nos callbacks de OAuth e links de recuperação de senha por e-mail)
FRONTEND_URL=https://app.arenix.com.br

# Fuso horário padrão
APP_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------------------
# SERVIÇO DE E-MAIL TRANSACIONAL (SMTP)
# Usado para recuperação de senha e e-mails de boas-vindas/ativação
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=suporte.arenix@gmail.com
EMAIL_PASS=sua_senha_de_app_aqui

# ------------------------------------------------------------------------------
# MERCADO PAGO CONNECT (OAUTH2 DO SAAS)
# Obtido no painel Mercado Pago Developers em 'Suas Aplicações'
# ------------------------------------------------------------------------------
MERCADO_PAGO_CLIENT_ID=seu_client_id_aqui
MERCADO_PAGO_CLIENT_SECRET=seu_client_secret_aqui
MERCADO_PAGO_REDIRECT_URI=https://api.arenix.com.br/api/pagamentos/gateway/oauth/callback
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_master_aqui

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (LOGIN SOCIAL)
# Obtido no Google Cloud Console em 'Credenciais'
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
